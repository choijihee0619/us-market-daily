# 복사해서 .env 로 쓰고, 절대 커밋하지 말 것 (.gitignore에 포함됨)

# --- 필수는 아님: 없으면 룰베이스 fallback으로 동작 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 데이터 소스 ---
# FRED: https://fredaccount.stlouisfed.org/apikeys (무료, 즉시 발급)
FRED_API_KEY=

# Alpha Vantage: https://www.alphavantage.co/support/#api-key (무료·즉시)
# 무료 티어 25요청/일, 5요청/분. NEWS_SENTIMENT의 ticker_sentiment가
# 종목 태깅 정밀도 문제를 해결해준다.
ALPHAVANTAGE_API_KEY=

# 선택: 뉴스 유료 소스로 승격할 때
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# SEC EDGAR는 키가 필요 없고 User-Agent에 연락처만 요구
SEC_USER_AGENT=us-market-daily heeppiness@pukyong.ac.kr


# --- 애널리틱스 (읽기 전용, 전부 선택) ---
# GA4 Data API는 서비스 계정을 지원한다. JSON 키 경로를 지정.
# 주의: 여기 들어가는 값은 '속성 ID'(숫자 9자리, 관리 > 속성 세부정보)다.
# 페이지에 심는 '측정 ID'(G-XXXXXXXXXX)는 공개 값이라 config.yaml 의
# site.ga4_measurement_id 에 둔다. 두 값을 섞으면 조용히 실패한다.
# 설치 절차: docs/SETUP_ANALYTICS.md
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# AdSense는 서비스 계정을 지원하지 않아 사용자 OAuth가 필요하다.
# 최초 1회 동의 후 refresh token을 받아 재사용한다.
ADSENSE_ACCOUNT=            # 예: accounts/pub-0000000000000000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# 위 설정이 없으면 data/analytics/{traffic,earnings}.csv 폴백으로 동작한다.
